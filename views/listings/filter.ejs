<% layout('/layouts/boilerplate') -%>
    <!-- <h2>All Listings</h2> -->
    <!-- <form method="GET" action="/listings/new">
        <button>Add Listings</button>
    </form> -->
    <style>
        .sub-nav{
            display: flex;
             justify-content: space-between;
        }

        #filters{
            display:flex;
            flex-wrap: wrap;
            align-items: center;
        }
        .filter{
            text-align: center;
            margin-top: 2rem;
            margin-right: 2rem;
            opacity: 0.7;
        }
        .filter:hover{
            opacity: 1;
            cursor: pointer;
        }
        .filter p{
            font-size: 0.8rem;
        }
        .filter a{
            text-decoration: none;
        }
        .tax-info{
            display: none;
        }
        .tax-toggle{
            background-color: #fe424d;
            color: whitesmoke;
            border-radius: 1rem;
            height: 3.2rem;
            padding: 1rem;
            display: flex;
            align-items: center;
            margin-top: 1.5rem;
        }
        .filter-ops{
            color: #22222285;
            font-size: 20px;
            border: 1px solid #00000036;
            border-radius: 1.2rem;
            padding: .8rem;
        }
    </style>

        <div class="sub-nav mt-2">
        <button class="btn d-lg-none mt-4 btn-lg" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasResponsive" aria-controls="offcanvasResponsive"><span class="filter-ops"><i class="fa-solid fa-bars" ></i></span></button>

        <div class="offcanvas-lg offcanvas-end" tabindex="-1" id="offcanvasResponsive" aria-labelledby="offcanvasResponsiveLabel">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title" id="offcanvasResponsiveLabel">Filters</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#offcanvasResponsive" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div id="filters">
            <div class="filter ">
                <a href="/listings/filters/?category=Trending" style="color: #212529;"><i   id="trendingIcon" class="fa-solid fa-fire" ></i><p>Trending</p></a>
            </div>
            <div class="filter ">
                <a href="/listings/filters/?category=Rooms" style="color: #212529;"> <i class="fa-solid fa-bed"></i><p>Rooms</p></a>
            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Iconic Cities" style="color: #212529;"><i class="fa-solid fa-mountain-city"></i><p>Iconic Cities</p></a>
            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Mountains" style="color: #212529;"> <i class="fa-solid fa-mountain"></i> <p>Mountains</p></a>

            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Castles" style="color: #212529;"> <i class="fa-brands fa-fort-awesome"></i> <p>Castles</p></a>

            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Amzing Pools" style="color: #212529;"> <i class="fa-solid fa-person-swimming"></i><p>Amzing Pools</p></a>

            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Camping" style="color: #212529;"> <i class="fa-solid fa-campground"></i><p>Camping</p></a>

            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Farms" style="color: #212529;"> <i class="fa-solid fa-tractor"></i><p>Farms</p></a>

            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Arctic" style="color: #212529;"><i class="fa-solid fa-person-skiing"></i><p>Arctic</p></a>

            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Domes" style="color: #212529;"><i class="fa-solid fa-igloo"></i><p>Domes</p></a>

            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Boats" style="color: #212529;"><i class="fa-solid fa-sailboat"></i><p>Boats</p></a>

            </div>
            <div class="filter">
                <a href="/listings/filters/?category=Beaches" style="color: #212529;"><i class="fa-solid fa-umbrella-beach"></i><p>Beaches</p></a>
            </div>
        </div>
        </div>
        </div>
        <div class="tax-toggle">
                    <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
                </div>
            </div>
        </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3">
        <% for(let listing of allListings){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card" >
                <img
                src="<%= listing.image.url %>"
                class="card-img-top"
                style="height: 20rem;"
                alt="listing_image">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b> <%= listing.title %></b> <br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                        <i class="tax-info"> &nbsp;&nbsp; +18%GST</i> <br>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
    </div>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");

taxSwitch.addEventListener("change", () => {
    let taxInfo = document.getElementsByClassName("tax-info");

    for (let info of taxInfo) {
        if (info.style.display != "inline") {
            info.style.display = "inline";
        } else {
            info.style.display = "none";
        }
    }
});


</script>